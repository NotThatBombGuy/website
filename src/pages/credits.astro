---
import Layout from "../layouts/Layout.astro";
---
<Layout title="BombDotCom">
	<h1 class="mid-text title-text">Credits.</h1>
	<div class="page-desc-container">
		<p class="indent">
			This site wouldn't be possible without the tools, fonts, and people below. If I forgot you, let me know!
		</p>
	</div>

	<div class="credits-container">

		<section class="credit-group">
			<h2 class="text-left">Fonts</h2>
			<ul>
				<li><a href="https://fonts.google.com/specimen/Montserrat" target="_blank" rel="noopener">Montserrat</a> — main body font, via Google Fonts</li>
				<li><a href="https://fonts.google.com/specimen/Dancing+Script" target="_blank" rel="noopener">Dancing Script</a> — logo font, via Google Fonts</li>
			</ul>
		</section>

		<section class="credit-group">
			<h2 class="text-left">Inspiration</h2>
			<ul>
				<li><a href="https://bwoah.dev" target="_blank" rel="noopener">bwoah.dev</a> — layout &amp; styling inspiration</li>
			</ul>
		</section>

		<section class="credit-group">
			<h2 class="text-left">People</h2>
			<ul>
				<li>TODO: add anyone who helped, gave feedback, or made assets for you</li>
			</ul>
		</section>

	</div>
</Layout>
