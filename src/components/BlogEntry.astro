---
const { post, Content } = Astro.props;
const { title, date, hasHidden, hidden, hasImg, imgSrc, imgAlt } = post.data;

const formattedDate = date.toLocaleDateString("en-US", {
	year: "2-digit",
	month: "numeric",
	day: "numeric",
	timeZone: "UTC",
});
---
<div class="blog-entry">
	<div class="blog-entry-header">
		<h2 class="blog-title">{title}</h2>
		<h3 class="blog-date">{formattedDate}</h3>
	</div>

	<div class="blog-desc">
		<Content />
	</div>

	{hasHidden && <p class="blog-hidden-desc">{hidden}</p>}

	{hasImg && <img class="blog-img" src={imgSrc} alt={imgAlt} />}
</div>
